{
  "expo": {
    "name": "Card Keeper",
    "slug": "card-keeper",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steve.cardkeeper"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.steve.cardkeeper",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3D2E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "style": "light"
        }
      ]
    ],
    "scheme": "cardkeeper",
    "backgroundColor": "#0B3D2E"
  }
}
